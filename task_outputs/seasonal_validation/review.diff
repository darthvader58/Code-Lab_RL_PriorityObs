+                    for kind,pname in [('lr','P5 logistic regression'),('lgbm','P6 gradient boosting')]:
+                        for src,ms in missions.items():
+                            target_src='prectot_nadir' if setting=='nadir' else ms.label_col
+                            fs=folds[src][i]
