+@dataclass(frozen=True)
+class SeasonalFold:
+    """One weather-month holdout. Indices refer to the original loaded frame."""
+    held_out_month: str
+    train_months: tuple
+    train_index: pd.Index
+    test_index: pd.Index
+    dropped_index: pd.Index
